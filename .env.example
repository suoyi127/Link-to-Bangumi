# Set these process environment variables before launching the backend.
ANIME_VAULT_BIND=127.0.0.1
ANIME_VAULT_PORT=8848
ANIME_VAULT_SOURCE_DIR=D:\追番\番剧
ANIME_VAULT_IMPORT_DIR=D:\追番\外来导入
ANIME_VAULT_LIBRARY_DIR=D:\追番\媒体库
ANIME_VAULT_DATA_DIR=D:\追番\anime-vault-data
ANIME_VAULT_QB_ENABLED=false

# Optional integration credentials belong in a private .env when implemented.
# ANIME_VAULT_QB_URL=
# ANIME_VAULT_QB_USERNAME=
# ANIME_VAULT_QB_PASSWORD=
